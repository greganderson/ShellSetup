### GREG START
export PATH=$PATH:$HOME/scripts
export PATH=$PATH:$HOME/bin
export PATH=$PATH:$HOME/bin/ripgrep
export PATH=$PATH:$HOME/bin/nvim/bin
export PATH=$PATH:$HOME/bin/vscode
export PATH=$PATH:$HOME/bin/go/bin
export PATH=$PATH:$HOME/bin/zig
export PATH=$PATH:$HOME/go/bin
export PATH=$PATH:$HOME/.local/share/gem/ruby/3.4.0/bin
export PATH=$PATH:$HOME/bin/android-studio/bin
export PATH=$PATH:$HOME/.local/share/mise/installs/node/25.1.0/bin
export PATH=$PATH:$HOME/bin/awesome-claude-code-subagents
export PATH=$PATH:$HOME/bin/intellij/bin/
export PATH=$PATH:$HOME/bin/flutter/bin
export PATH=$PATH:$HOME/.cargo/bin
export PATH=$PATH:$HOME/.pub-cache/bin

# Intellij is opened with idea, which is weird to me. Add this as an option. Might get rid of it if I do remember to use idea instead of intellij
alias intellij=idea

# Android
export ANDROID_HOME=$HOME/Android/Sdk
export PATH=$PATH:$ANDROID_HOME/emulator
export PATH=$PATH:$ANDROID_HOME/platform-tools

